# ==============================================================
# Oskar Cephalo v2 Deployment — .gitignore
# ==============================================================

# ─── Python Caches & Build Artifacts ──────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ─── Virtual Environments ────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ─── Large Datasets & Raw Medical Files (NEVER PUSH) ────────
/data/
/dataset/
/datasets/
/raw_data/
/Cephalograms/
/Annotations/
*.dcm
*.dicom
*.tar.gz
*.zip
*.rar
*.7z

# ─── PyTorch Training Artifacts & Old Checkpoints ────────────
checkpoints/
*.pth
*.pt
*.ckpt
*.h5
*.pkl
logs/
events.out.tfevents.*
runs/

# ─── Old Project Files (from "final v1" parent folder) ───────
# These belong to the training workspace, not deployment
/train*.py
/dataset*.py
/config*.py
/Aariz*/
/CL-detection*/
/ISBI*/

# ─── IDE & Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ─── OS Generated Files ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Jupyter Notebooks ──────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Testing & Coverage ─────────────────────────────────────
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml

# ─── Docker ──────────────────────────────────────────────────
*.log
docker-compose.override.yml

# ─── Large Model Files ──────────────────────────────────────
# oskar_cephalo.onnx is ~250 MB and MUST be tracked via Git LFS.
# If not using Git LFS, uncomment the line below to exclude it:
# *.onnx
